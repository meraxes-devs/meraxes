#------------------------------------------
#----- Simulation input files  ------------
#------------------------------------------
# Low-resolution test set (76 snapshots, z ~ 30 to 10), also used by the
# regression tests. Data: Zenodo record "Genesis L10_N512" (L10_N512.zip),
# which unpacks to a_list.txt, grids/ (32^3) and trees/.
SimName           : Genesis L10_N512
SimulationDir     : /g/data/cm25/yq5547/dragons/input_trees/Maynooth/LR_trees
CatalogFilePrefix : tree_new.hdf5
TreesID           : 0  # 0 -> VELOCIraptor; 1 -> gbpTrees, 2 -> VELOCIraptor augmented
BoxSize           : 10.0
VolumeFactor      : 1.0

#------------------------------------------------
#----- Cosmological and nbody sim parameters ----
#------------------------------------------------
OmegaM: 0.3121
OmegaK: 0.000
OmegaLambda: 0.6879
OmegaR: 0.0
BaryonFrac: 0.15714
Hubble_h: 0.6751
SpectralIndex: 0.968
Sigma8: 0.815
PartMass: 6.4536e-05
wLambda: -1.0
NPart: 134217728

UnitLength_in_cm         : 3.08568e+24       # WATCH OUT : Mpc/h
UnitMass_in_g            : 1.989e+43         # WATCH OUT : 10^10Msun/h
UnitVelocity_in_cm_per_s : 100000            # WATCH OUT : km/s

ReionGridDim : 32

# Regression-test setup "xray_metallicity_scatter".
# USE_STOCHASTICITY build; metallicity-dependent HMXB luminosity with scatter and recalibration.
# CMake fills in @INPUT_FILE_DIR@ and @MERAXES_TESTDATA_DIR@.
# Keep a separate reference for this setup; retain the original flag-off references.

FileNameGalaxies     : meraxes
DefaultsFile         : @INPUT_FILE_DIR@/params/defaults.par
SimParamsFile        : @INPUT_FILE_DIR@/params/simulations/Genesis_L10_N512.par
SimulationDir        : @MERAXES_TESTDATA_DIR@/L10_N512
OutputDir            : output
OutputSnapshots      : 48, 63, 75  # z = 15, 12, 10
RandomSeed           : 1809
PhotometricTablesDir : @INPUT_FILE_DIR@/photometric_tables
CoolingFuncsDir      : @INPUT_FILE_DIR@/cooling_functions
StellarFeedbackDir   : @INPUT_FILE_DIR@/stellar_feedback_tables/Kroupa
TablesForXHeatingDir : @INPUT_FILE_DIR@/21cmFAST-tables
RecombinationDir     : @INPUT_FILE_DIR@/

# Physics for this setup
Flag_IncludeSpinTemp       : 1
Flag_Compute21cmBrightTemp : 1
Flag_ComputePS             : 1
Flag_IncludeAGNXray        : 1
Flag_OutputXrayLF          : 1
Flag_BHARExponentialCut    : 1

# Metallicity-dependent HMXB luminosity
Flag_UseXrayMetallicity                   : 1
XrayLogLNorm              : 40.68
XrayMetallicitySlope      : -1.22
XrayMetallicitySolar      : 0.0134
XrayOxygenAbundanceFactor : 1.0
EscapeFracScatterDex      : 0.0
Flag_RemoveSFRScatter     : 0
XrayScatterDex            : 0.3
Flag_SourceRecalibration  : 1
